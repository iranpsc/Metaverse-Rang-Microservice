# Challenge localization and advertisement media
PROJECT_LOCALE=EN
PROJECT_URL=http://localhost:8000

# gRPC Server (internal / service-to-service)
GRPC_PORT=50061

# HTTP Server (Kong upstream for /api/followers, /api/challenge, etc.)
HTTP_PORT=8064

# Public base URL for pagination links (Kong gateway)
APP_URL=http://localhost:8000

# Metrics
METRICS_PORT=9090

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
TZ=Asia/Tehran
DB_DATABASE=metarang_db

# Inter-service authentication (required for wallet mutation RPCs to commercial-service)
INTERNAL_SERVICE_SECRET=change-me-in-production

# Service Addresses
AUTH_SERVICE_ADDR=auth-service:50051
COMMERCIAL_SERVICE_ADDR=commercial-service:50052
LEVELS_SERVICE_ADDR=levels-service:50054
