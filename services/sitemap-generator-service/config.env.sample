# Sitemap Generator Service Configuration
PROJECT_LOCALE=EN

# HTTP Server (health + manual regenerate)
HTTP_PORT=8071

# Sitemap export directory (bind-mounted from host in docker-compose)
SITEMAPS_EXPORT_PATH=/opt/metarang/sitemaps

# Citizen URL templates
TEMPLATES_PATH=./templates/templates.json

# Admin panel base for category/sub-category image URLs
ADMIN_PANEL_URL=https://admin.metarang.com

# Scheduler interval in hours
SITEMAP_SCHEDULER_INTERVAL_HOURS=3

# Metrics
METRICS_PORT=9090

# Database Configuration (read-only user; created by migration)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=metarang_db
DB_USER=sitemap_service
DB_PASSWORD=sitemap_password
TZ=Asia/Tehran

# Required for POST /generate (X-Service-Token). Compose injects INTERNAL_SERVICE_SECRET.
# INTERNAL_SERVICE_SECRET=
