# Sitemap Generator Service
# Copy to config.env (gitignored) or run scripts/generate-configs.sh from the repo root.

# Host directory bind-mounted onto the service sitemaps directory (/app/sitemaps).
# Compose reads this name from the project environment (.env or the shell) for the
# host side of the bind. The default matches this value.
SITEMAPS_EXPORT_PATH=/opt/metarang/sitemaps

# Directory the process writes. In Docker this is the container sitemaps directory,
# which the bind mount above attaches to SITEMAPS_EXPORT_PATH.
SITEMAPS_OUTPUT_DIR=/app/sitemaps

# templates.json shipped in the service root.
TEMPLATES_PATH=/app/templates.json

# Image prefix for education category and subcategory sitemap entries.
ADMIN_PANEL_URL=https://admin.rgb.irpsc.com

# Health endpoint (liveness). Generation runs in-process on a 3-hour ticker.
HTTP_PORT=8071

# Database (shared MetaRang schema). Compose overrides DB_* for container networking.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=metarang_db
DB_USER=metarang_user
DB_PASSWORD=metarang_password
TZ=Asia/Tehran
