# App Information
APP_URL=http://localhost:8000
APP_NAME=Metarang
APP_ENV=local
PROJECT_LOCALE=EN

FRONT_END_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:8000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
TZ=Asia/Tehran
DB_DATABASE=metarang_db

# OAuth Configuration
OAUTH_SERVER_URL=https://oauth.example.com
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# SMS (Kavenegar - used for OTP, delegated to notifications-service)
KAVENEGAR_API_KEY=your-kavenegar-api-key

# Admin panel base URL for level image paths (admin_panel_url + /uploads/ + image.url)
ADMIN_PANEL_URL=http://localhost:8000

# gRPC Configuration
GRPC_PORT=50051
HTTP_PORT=8066

# Service Dependencies
NOTIFICATIONS_SERVICE_ADDR=notifications-service:50058
LEVELS_SERVICE_ADDR=levels-service:50054
COMMERCIAL_SERVICE_ADDR=commercial-service:50052
STORAGE_SERVICE_ADDR=storage-service:50060

# Redis Configuration (for caching state, tokens, etc.)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

