# App Locale
PROJECT_LOCALE=EN

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
TZ=Asia/Tehran
DB_DATABASE=metarang

# Server Configuration
GRPC_PORT=50052
HTTP_PORT=8067
AUTH_SERVICE_ADDR=auth-service:50051
# Public base URL for pagination links when behind Kong (preserve_host=false)
APP_URL=http://localhost:8000

# Inter-service authentication (required for wallet mutation RPCs)
INTERNAL_SERVICE_SECRET=change-me-in-production

# Optional inter-service TLS/mTLS (see scripts/generate-grpc-certs.sh)
GRPC_TLS_ENABLED=false
