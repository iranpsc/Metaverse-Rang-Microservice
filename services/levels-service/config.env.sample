# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=metarang_user
DB_PASSWORD=metarang_password
TZ=Asia/Tehran
DB_DATABASE=metarang_db

# gRPC Configuration
GRPC_PORT=50054
HTTP_PORT=8061
COMMERCIAL_SERVICE_ADDR=commercial-service:50052

# Inter-service authentication (required for wallet mutation RPCs to commercial-service)
INTERNAL_SERVICE_SECRET=change-me-in-production

# Metrics Configuration
METRICS_PORT=9090

# Public gateway URL (Kong) — used for image URL formatting in HTTP responses
APP_URL=http://localhost:8000

# Admin Panel URL (for repository-level image URL formatting)
# Used to format image URLs as: ADMIN_PANEL_URL + /uploads/ + image_path
ADMIN_PANEL_URL=http://localhost:8000
